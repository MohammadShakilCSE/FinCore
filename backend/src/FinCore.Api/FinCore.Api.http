@FinCore.Api_HostAddress = http://localhost:5196
@accessToken = paste-login-access-token-here
@walletId = 00000000-0000-0000-0000-000000000001

### Register
POST {{FinCore.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Shakil",
  "email": "shakil@example.com",
  "password": "ExamplePassword123!"
}

### Login; copy accessToken into the variable above.
POST {{FinCore.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "shakil@example.com",
  "password": "ExamplePassword123!"
}

### Current customer
GET {{FinCore.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{accessToken}}

### Create wallet; ownership comes from the token.
POST {{FinCore.Api_HostAddress}}/api/wallets
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "currency": "BDT" }

### Own wallet
GET {{FinCore.Api_HostAddress}}/api/wallets/{{walletId}}
Authorization: Bearer {{accessToken}}

### Public demo deposits are disabled (404 for an authenticated customer).
POST {{FinCore.Api_HostAddress}}/api/wallets/{{walletId}}/demo-deposits
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "amount": 500, "currency": "BDT" }

### Transfer; use distinct sender and receiver wallet IDs.
POST {{FinCore.Api_HostAddress}}/api/transfers
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "senderWalletId": "{{walletId}}",
  "receiverWalletId": "00000000-0000-0000-0000-000000000002",
  "amount": 100,
  "currency": "BDT",
  "idempotencyKey": "example-transfer-1"
}

### Only the initiating customer can retrieve this attempt.
GET {{FinCore.Api_HostAddress}}/api/transfers/attempts/example-transfer-1
Authorization: Bearer {{accessToken}}
